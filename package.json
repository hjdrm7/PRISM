{
  "name": "PRISM",
  "productName": "PRISM",
  "version": "4.0.0",
  "description": "Batch event-photo enhancer and watermark stamper.",
  "main": "src/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && electron-builder --win --x64",
    "dist:win": "npm run build:renderer && electron-builder --win --x64",
    "dist:win:portable": "npm run build:renderer && electron-builder --win portable --x64",
    "dist:win:installer": "npm run build:renderer && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "lucide-react": "^1.31.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "org.prism.photoprocessor",
    "productName": "PRISM",
    "files": [
      "dist/**",
      "src/main/**",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PRISM-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PRISM-Setup-${version}-${arch}.${ext}"
    }
  }
}